SECRET_KEY=changeme
FIELD_ENCRYPTION_KEY=changeme
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Environment (local = SQLite, production/staging = PostgreSQL)
ENVIRONMENT=local

# Database - PostgreSQL (only used when ENVIRONMENT != local)
DB_NAME=kuberns
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Alternative: Database URL (overrides individual DB settings if provided)
# DATABASE_URL=postgresql://user:password@localhost:5432/kuberns

# AWS (for production)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1

# CORS settings
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub OAuth (get these from https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback